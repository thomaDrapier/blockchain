		"devdoc": {
			"details": "Plateforme de mise en relation de freelances avec un systeme de paiement par sequestre (escrow).",
			"kind": "dev",
			"methods": {
				"buyService(uint256)": {
					"details": "Permet a un acheteur de commander un service. Les fonds sont conserves par le contrat (sequestre) jusqu'a la finalisation."
				},
				"completeOrder(uint256)": {
					"details": "Permet a l'acheteur de valider la conformite du travail. Declenche la liberation des fonds du sequestre vers le portefeuille du vendeur."
				},
				"createService(string,uint256,uint256)": {
					"details": "Permet a un vendeur de referencer une nouvelle prestation."
				},
				"deliverOrder(uint256)": {
					"details": "Permet au vendeur de signaler que le travail a ete fourni. Cette etape est necessaire pour que l'acheteur puisse proceder a la validation finale."
				},
				"respondToOrder(uint256,bool)": {
					"details": "Permet au vendeur d'accepter ou de refuser une commande entrante. En cas de refus, les fonds sont immediatement restitues a l'acheteur."
				}
			},
